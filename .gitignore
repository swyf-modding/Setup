# Build output
bin/
obj/

# Game / BepInEx artefacts that belong to an install, not to a repo.
#
# vendor\ IS tracked: it holds the loader half of Doorstop and the unstripped BCL, both
# redistributable (LGPL-2.1 and MIT respectively, see vendor\README.md). Everything else
# binary here is either generated by scripts\ or not ours to redistribute - the game's own
# assemblies and the patched copies made from them.
unstripped_corlib/
unstripped_corlib_removed/
BepInEx/
LogOutput.log
preloader_*.log
Player.log
doorstop_config.ini
winhttp.dll
.doorstop_version

*.pdb
*.exe
*.mdb

# Keep the vendored redistributable binaries that setup.ps1 seeds from. Without these
# negations the rules above match vendor\ too, since git ignore patterns are not
# anchored to the repo root.
!vendor/corlib/*.dll
!vendor/doorstop/winhttp.dll
!vendor/doorstop/.doorstop_version
!vendor/doorstop/doorstop_config.ini

# Editors
.vs/
.idea/
*.user