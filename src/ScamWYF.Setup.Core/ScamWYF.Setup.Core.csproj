<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The setup logic, as a library, so the CLI and Switchboard run the same code rather than each
    driving PowerShell. Cross-platform on purpose: the Windows-only PowerShell scripts it replaces
    could not run on Linux, and Switchboard's WPF host cannot either.

    Mono.Cecil is a PackageReference rather than a vendored dll here. The old tools loaded it out of
    the game's BepInEx\core at run time, which meant the patching steps could only run after BepInEx
    was installed. Compiling against it removes that ordering constraint and works before the game is
    touched at all.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ScamWYF.Setup.Core</AssemblyName>
    <RootNamespace>ScamWYF.Setup</RootNamespace>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!--
    The vendored binaries, compiled in under a fixed `payload/` prefix so a published build is one
    file with no `Setup\` folder beside it. LogicalName is explicit for every one of them because the
    names are the contract SetupPayload reads back, and because `.doorstop_version` has no stem for
    the default naming rule to use.

    They are embedded in every configuration, not only Release, so a debug build and the tests
    exercise the same payload path a user gets.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../vendor/corlib/mscorlib.dll" LogicalName="payload/corlib/mscorlib.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.dll" LogicalName="payload/corlib/System.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.Core.dll" LogicalName="payload/corlib/System.Core.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.Configuration.dll" LogicalName="payload/corlib/System.Configuration.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.Numerics.dll" LogicalName="payload/corlib/System.Numerics.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.Security.dll" LogicalName="payload/corlib/System.Security.dll" />
    <EmbeddedResource Include="../../vendor/corlib/System.Xml.dll" LogicalName="payload/corlib/System.Xml.dll" />
    <EmbeddedResource Include="../../vendor/corlib/Mono.Security.dll" LogicalName="payload/corlib/Mono.Security.dll" />

    <EmbeddedResource Include="../../vendor/doorstop/winhttp.dll" LogicalName="payload/doorstop/winhttp.dll" />
    <EmbeddedResource Include="../../vendor/doorstop/.doorstop_version" LogicalName="payload/doorstop/.doorstop_version" />
    <EmbeddedResource Include="../../vendor/doorstop/doorstop_config.ini" LogicalName="payload/doorstop/doorstop_config.ini" />
  </ItemGroup>

</Project>
