<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `swyf-setup` - the front-end for someone who only wants the BepInEx system and no launcher.

    Published self-contained and single-file per platform, so the download is one executable with the
    vendored Doorstop and unstripped corlib compiled inside it. See build.sh / build.ps1.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>swyf-setup</AssemblyName>
    <RootNamespace>ScamWYF.Setup.Cli</RootNamespace>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Only needed for `dotnet run`, which resolves the framework from the machine; a published
         self-contained build carries its own. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ScamWYF.Setup.Core/ScamWYF.Setup.Core.csproj" />
  </ItemGroup>

</Project>
